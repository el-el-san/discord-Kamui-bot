# Kamui Multi-Platform Bot Configuration Example
# Copy this file to .env and fill in your actual values

# ===================================
# PLATFORM SELECTION
# ===================================
# Choose which platform(s) to run: 'discord', 'slack', 'line', 'both', or 'all'
BOT_PLATFORM=discord

# ===================================
# DISCORD CONFIGURATION
# ===================================
# Required for Discord bot functionality
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# Optional Discord settings
DISCORD_PREFIX=!
DISCORD_BOT_NAME=Kamui

# ===================================
# SLACK CONFIGURATION  
# ===================================
# Required for Slack bot functionality
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_APP_TOKEN=xapp-your-slack-app-token-here
SLACK_SIGNING_SECRET=your_slack_signing_secret_here

# Slack connection mode
# true = Socket Mode (recommended for development)
# false = HTTP Mode (for production deployment)
SLACK_SOCKET_MODE=true

# HTTP server port (only used when SLACK_SOCKET_MODE=false)
SLACK_PORT=3000

# Optional Slack settings
SLACK_BOT_NAME=Kamui

# ===================================
# LINE CONFIGURATION
# ===================================
# Required for LINE bot functionality
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# LINE webhook server port
LINE_WEBHOOK_PORT=3000

# LINE public URL for media file serving (HTTPS required)
LINE_PUBLIC_URL=https://your-domain.com

# Optional LINE settings
LINE_BOT_NAME=Kamui

# ===================================
# CLOUDFLARE TUNNEL CONFIGURATION
# ===================================
# Named tunnel configuration
TUNNEL_NAME=your-bot-name
TUNNEL_DOMAIN=your-domain.com

# Recommended tunnel names (for setup script)
# TUNNEL_NAMES=your-bot-name,example-bot,my-linebot,test-bot

# ===================================
# SYSTEM CONFIGURATION
# ===================================
# Timeout values (milliseconds)
TUNNEL_STARTUP_TIMEOUT=30000
BOT_RESTART_DELAY=3000
BOT_STARTUP_DELAY=2000
WEBHOOK_RESPONSE_TIMEOUT=15000
EVENT_PROCESSING_TIMEOUT=300000
TEMP_FILE_CLEANUP_DELAY=30000
FFMPEG_TIMEOUT=10000
FILE_SERVE_TIMEOUT=60000

# LocalTunnel configuration
LOCALTUNNEL_SUBDOMAIN=your-linebot

# System paths
CLOUDFLARED_ARCH=linux-amd64
TEMP_DIR=/tmp
DEFAULT_VIDEO_THUMBNAIL=default_video_thumb.jpg

# API endpoints
LINE_API_HOST=api.line.me
LINE_DEVELOPERS_URL=https://developers.line.biz/

# Processing limits
MAX_MESSAGE_LENGTH_DISCORD=2000
MAX_MESSAGE_LENGTH_LINE=5000
MAX_LINE_LENGTH=50000
MAX_BODY_LOG_LENGTH=2000
CLAUDE_PROCESS_TIMEOUT=185000
MCP_TOOL_TIMEOUT=180000
DEFAULT_TOOL_TIMEOUT=60000

# ===================================
# CLAUDE CODE SDK CONFIGURATION
# ===================================
# Timeout for Claude API calls (milliseconds)
CLAUDE_TIMEOUT=180000

# Logging level
LOG_LEVEL=info

# File detection time limit (minutes)
# Set to 0 or negative value to disable time limit
# Shorter time = more accurate file detection (recommended: 2-5 minutes)
FILE_DETECTION_MINUTES=2

# ===================================
# SETUP INSTRUCTIONS
# ===================================

# DISCORD SETUP:
# 1. Go to https://discord.com/developers/applications
# 2. Create a new application
# 3. Go to the "Bot" section
# 4. Create a bot and copy the token to DISCORD_BOT_TOKEN
# 5. Copy the Application ID to DISCORD_CLIENT_ID
# 6. Enable necessary intents: Message Content Intent
# 7. Invite bot with permissions: Send Messages, Use Slash Commands, Attach Files

# SLACK SETUP:
# 1. Go to https://api.slack.com/apps
# 2. Create a new app from manifest or from scratch
# 3. Add Bot Token Scopes: chat:write, files:write, commands
# 4. Add Event Subscriptions: message.channels, app_mention
# 5. Enable Socket Mode and create App-Level Token
# 6. Install app to workspace and copy tokens
# 7. Add slash commands: /ask, /reset, /help

# LINE SETUP:
# 1. Go to https://manager.line.biz/ to create LINE Official Account
# 2. Go to https://developers.line.biz/ to access Developers Console
# 3. Select your provider and enable Messaging API
# 4. In "Messaging API" tab, issue Channel Access Token
# 5. In "Basic settings" tab, copy Channel Secret
# 6. Set webhook URL: https://your-domain.com/webhook
# 7. Enable "Use webhook" in Messaging API settings
# 8. Disable auto-reply in LINE Official Account Manager

# MULTIPLE PLATFORMS:
# Set BOT_PLATFORM=both (Discord+Slack), all (Discord+Slack+LINE), or specific platform

# ===================================
# QUICK SETUP EXAMPLES
# ===================================

# LINE Bot Only:
# BOT_PLATFORM=line
# LINE_CHANNEL_ACCESS_TOKEN=your_actual_token
# LINE_CHANNEL_SECRET=your_actual_secret

# Discord + LINE:
# BOT_PLATFORM=both
# DISCORD_BOT_TOKEN=your_discord_token
# LINE_CHANNEL_ACCESS_TOKEN=your_line_token
# LINE_CHANNEL_SECRET=your_line_secret

# All Platforms:
# BOT_PLATFORM=all
# (Configure all Discord, Slack, and LINE tokens above)

# ===================================
# DEVELOPMENT COMMANDS
# ===================================

# Quick Start (LINE Bot + Tunnel):
# 1. Copy .env.example to .env
# 2. Set LINE_CHANNEL_ACCESS_TOKEN and LINE_CHANNEL_SECRET
# 3. Set BOT_PLATFORM=line
# 4. Run: npm run dev-full

# Available Commands:
# npm run dev-full        - Bot + Tunnel integrated startup (recommended)
# npm run tunnel:setup    - Tunnel only
# npm start               - Bot only
# npm run tunnel:cf       - Cloudflare Tunnel direct
# npm run tunnel:lt       - LocalTunnel direct
